# Server Port
PORT=5050

# MongoDB Connection String (Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/klavo?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/klavo

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (Backend verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Storage Configuration (Optional / File upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
