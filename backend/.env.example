# ==============================================================================
# Klavo Backend Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - This file contains PLACEHOLDERS ONLY. Never commit real secrets or credentials.
# - Inject production secrets at runtime using your cloud secrets manager or container env.
# ==============================================================================

# Node Environment: 'development', 'test', or 'production'
NODE_ENV=development

# Server Port
PORT=5050

# MongoDB Connection String (Atlas replica set or local instance)
# Production Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/klavo?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/klavo

# JWT Secret Key for token signing (Must be >= 32 characters long in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Frontend Web Application URL (Allowed CORS Origin)
# Example: https://app.klavo.example.com
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (if multiple domains or staging environments)
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth 2.0 Client ID (for ID token verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Persistent Object Storage (REL-05)
# ------------------------------------------------------------------------------
# Storage Provider Strategy: 'local' (development) or 's3' (production object store)
STORAGE_PROVIDER=local

# Local uploads directory (used when STORAGE_PROVIDER=local or for temporary staging)
UPLOADS_DIR=uploads

# S3 Configuration (Required only when STORAGE_PROVIDER=s3)
# Suitable for AWS S3, Cloudflare R2, MinIO, or Google Cloud Storage (S3-interop)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# Security & Proxy Settings
# ------------------------------------------------------------------------------
# Set to 'true' if behind reverse proxies (Nginx, Cloudflare, AWS ALB)
TRUST_PROXY=false

# Force secure cookie transmission (auto-enabled when NODE_ENV=production)
COOKIE_SECURE=false
