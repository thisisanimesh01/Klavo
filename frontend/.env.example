# ==============================================================================
# Klavo Frontend Build-Time Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - All variables prefixed with VITE_ are embedded into the client-side JavaScript bundle.
# - NEVER include private API secrets, database passwords, or JWT secrets here.
# ==============================================================================

# Backend REST API base URL
# Local Dev: http://localhost:5050/api | Production: https://api.klavo.example.com/api
VITE_API_URL=http://localhost:5050/api

# Backend Socket.IO Server URL
# Local Dev: http://localhost:5050 | Production: https://api.klavo.example.com
VITE_BACKEND_URL=http://localhost:5050

# Google OAuth Client ID (Public Web Client ID for Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
